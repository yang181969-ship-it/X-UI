# X-UI Product v1 (apps/ledger-api + apps/ledger-web). Copy to .env.v1 — never commit .env.v1.
# This file is separate from the legacy .env: v1 reads only XUI_V1_* keys and never opens .env.
# On a fresh install (no .env.v1 and no data/x-ui-v1.db) `npm run dev:v1` creates .env.v1 with
# new random secrets. Generate values by hand with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# 32-byte key that encrypts stored secrets (TOTP seeds; card data from M2). Use a NEW key —
# do not copy the legacy APP_ENC_KEY. BACK IT UP: if it is lost, encrypted data cannot be read.
XUI_V1_APP_ENC_KEY=

# Secret mixed into password hashes (changing it invalidates all passwords).
XUI_V1_SESSION_PEPPER=

# One-time first-run setup link: http://localhost:5174/setup/<token> creates the only account
# while none exists. Afterwards the link stops working and the value can be removed.
XUI_V1_SETUP_TOKEN=

# WebAuthn (passkeys): relying party id = the hostname users open.
# Locally always use http://localhost (not 127.0.0.1 / LAN IP) — passkeys and the Origin check require it.
XUI_V1_RP_ID=localhost
XUI_V1_RP_NAME=X-UI

# Browser origins allowed to call the v1 API (Vite dev server and the built app).
XUI_V1_ORIGINS=http://localhost:5174,http://localhost:8788

# true when served over HTTPS (adds Secure/__Host- cookies and HSTS).
XUI_V1_COOKIE_SECURE=false
# true only when running behind a trusted reverse proxy / Cloudflare.
XUI_V1_TRUST_PROXY=false

# Optional
# XUI_V1_DATABASE_URL=file:/absolute/path/to/x-ui-v1.db   # default: data/x-ui-v1.db (z-ui.db is refused)
# XUI_V1_PORT=8788
# XUI_V1_HOST=127.0.0.1
# XUI_V1_PASSWORD_ITERATIONS=50000
