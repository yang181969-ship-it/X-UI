{
  "name": "z-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Z-UI personal finance ledger (React 19 + Ant Design 6 + Hono).",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev -w @z-ui/api\" \"npm:dev -w @z-ui/web\"",
    "build": "npm run build -w @z-ui/web",
    "start": "npm run start -w @z-ui/api",
    "create-admin": "npm run create-admin -w @z-ui/api",
    "db:generate": "npm run db:generate -w @z-ui/api",
    "db:migrate": "npm run db:migrate -w @z-ui/api",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint packages apps",
    "bin:sync": "NODE_USE_ENV_PROXY=1 node scripts/bin-sync.mjs",
    "d1:export": "node scripts/export-d1.mjs",
    "cf:dev": "npm run build && wrangler dev --port 8790 --local-upstream localhost:8790",
    "cf:deploy": "node scripts/cf-check.mjs && npm run build && wrangler d1 migrations apply z-ui --remote && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
