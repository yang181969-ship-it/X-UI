# Copy to .env (never commit .env). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# 32-byte key that encrypts stored card numbers and TOTP secrets.
# BACK IT UP somewhere safe: if it is lost, stored card numbers cannot be decrypted.
APP_ENC_KEY=

# Secret mixed into password hashes (changing it invalidates all passwords).
SESSION_PEPPER=

# WebAuthn (passkeys): relying party id = the hostname users open.
# Locally always use http://localhost (not 127.0.0.1 / LAN IP) — passkeys require it.
RP_ID=localhost
RP_NAME=Z-UI

# Browser origins allowed to call the API (Vite dev server and the built app).
ORIGINS=http://localhost:5173,http://localhost:8787

# true when served over HTTPS (adds Secure/__Host- cookies and HSTS).
COOKIE_SECURE=false
# true only when running behind a trusted reverse proxy / Cloudflare.
TRUST_PROXY=false

# Optional
# FINNHUB_API_KEY=            # stock quotes via Finnhub (default: Yahoo Finance, no key)
# PASSWORD_ITERATIONS=50000   # PBKDF2 cost; 50k also fits Cloudflare's free plan (keep it for d1:export)
# PORT=8787
# HOST=127.0.0.1
# DATABASE_URL=file:/absolute/path/to/z-ui.db
# Settings (currencies, countries, custom fields…) live in the database and are edited in the UI;
# config/app.config.json only seeds a fresh install.
